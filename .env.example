TAR_ENV=development
TAR_API_HOST=0.0.0.0
TAR_API_PORT=8000
TAR_DATABASE_URL=sqlite:///./tar.db
TAR_VECTOR_BACKEND=memory
TAR_IPFS_API_URL=http://ipfs:5001
TAR_IPFS_GATEWAY=http://localhost:8080/ipfs
TAR_ARTIFACT_DIR=./artifacts

TAR_LLM_PROVIDER=echo
TAR_LLM_API_KEY=
TAR_LLM_BASE_URL=
TAR_LLM_MODEL=

# OpenAI-compatible or provider-specific image endpoint that accepts model/prompt/size.
TAR_IMAGE_API_URL=
TAR_IMAGE_API_KEY=
TAR_IMAGE_MODEL=

# Video provider endpoint. Adapter supports immediate URL responses or status_url polling.
TAR_VIDEO_API_URL=
TAR_VIDEO_API_KEY=
TAR_VIDEO_MODEL=

# Disabled by default. Enable only when the API worker itself is isolated/sandboxed.
TAR_ENABLE_CODE_EXECUTION=false
TAR_PYTHON_BIN=python

TAR_ALLOWED_ORIGINS=http://localhost:3000
TAR_REQUEST_TIMEOUT=30
