TAR_ENV=development
TAR_API_HOST=0.0.0.0
TAR_API_PORT=8000
TAR_DATABASE_URL=sqlite:///./tar.db
TAR_VECTOR_BACKEND=memory
TAR_IPFS_API_URL=http://ipfs:5001
TAR_IPFS_GATEWAY=http://localhost:8080/ipfs

# Artifact storage: local for single-host development, s3 for distributed deployments.
TAR_ARTIFACT_BACKEND=local
TAR_ARTIFACT_DIR=./artifacts
TAR_S3_ENDPOINT_URL=
TAR_S3_BUCKET=tar-artifacts
TAR_S3_REGION=us-east-1
TAR_S3_PREFIX=tar-artifacts
TAR_S3_ACCESS_KEY_ID=
TAR_S3_SECRET_ACCESS_KEY=
TAR_S3_SESSION_TOKEN=
TAR_S3_ADDRESSING_STYLE=path
# Local MinIO profile credentials. Replace these before using the profile beyond a developer machine.
TAR_MINIO_ROOT_USER=tar-minio
TAR_MINIO_ROOT_PASSWORD=change-me-minio

# Require workspace credentials on any network-accessible deployment.
TAR_REQUIRE_API_KEY=false
# Separate control-plane and remote-worker credentials.
TAR_ADMIN_KEY=
TAR_WORKER_KEY=
TAR_POSTGRES_PASSWORD=change-me

TAR_NARA_API_KEY=
TAR_NCBI_EMAIL=
TAR_NCBI_API_KEY=

TAR_LLM_PROVIDER=echo
TAR_LLM_API_KEY=
TAR_LLM_BASE_URL=
TAR_LLM_MODEL=

# Optional local semantic reranking. When disabled or unavailable, retrieval falls back to lexical ranking.
TAR_ENABLE_SEMANTIC_RETRIEVAL=false
TAR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TAR_SEMANTIC_SCAN_LIMIT=1500

TAR_IMAGE_API_URL=
TAR_IMAGE_EDIT_API_URL=
TAR_IMAGE_API_KEY=
TAR_IMAGE_MODEL=
TAR_IMAGE_EDIT_MODEL=

TAR_VIDEO_API_URL=
TAR_VIDEO_API_KEY=
TAR_VIDEO_MODEL=

TAR_TRANSCRIBE_API_URL=
TAR_TRANSCRIBE_API_KEY=
TAR_TRANSCRIBE_MODEL=

# Never enable on the API host. Use only inside a hardened sandbox worker.
TAR_ENABLE_CODE_EXECUTION=false
TAR_PYTHON_BIN=python

TAR_CHAIN_RPC_URL=
TAR_GOVERNANCE_ADDRESS=

TAR_ALLOWED_ORIGINS=http://localhost:3000
TAR_REQUEST_TIMEOUT=30
